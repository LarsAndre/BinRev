---
import { publishedResources, summary } from '../lib/content';
const resources = await publishedResources();
---
<div class="resource-grid">{resources.map((resource, index) => (
  <a class="resource-card" href={resource.data.url}>
    <div class="resource-preview"><img src={resource.data.image} alt="" loading="lazy" /><span class="resource-number">{String(index + 1).padStart(2, '0')}</span></div>
    <div class="resource-card-body"><span class="eyebrow">{resource.data.sectionTitle}</span><h3>{resource.data.title} <span aria-hidden="true">↗</span></h3><p>{summary(resource)}</p><span class="resource-type">{resource.data.format}</span></div>
  </a>
))}</div>
