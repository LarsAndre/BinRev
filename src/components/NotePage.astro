---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import DiagramViewer from './DiagramViewer.astro';
import { summary, sourceUrl, type Note } from '../lib/content';
interface Props { entry: Note; }
const { entry } = Astro.props;
const isAnalysis = entry.data.kind === 'analysis';
const backUrl = isAnalysis ? '/analyses/' : `/#${entry.data.section}-heading`;
const backLabel = isAnalysis ? 'analyses' : entry.data.sectionTitle;
const { Content, headings } = await render(entry);
const sections = headings.filter(heading => heading.depth === 2);
---
<Base title={entry.data.title} description={summary(entry)}>
  <div class="container article-shell">
    <article>
      <header class="article-header"><a class="breadcrumb" href={backUrl}>← {isAnalysis ? 'All analyses' : entry.data.sectionTitle}</a><p class="eyebrow">{entry.data.sectionTitle} / {String(entry.data.completed) === 'true' ? 'Completed' : 'Working notes'}</p><h1>{entry.data.title}<span class="brand-dot">.</span></h1><p class="page-description">{summary(entry)}</p><div class="tags">{entry.data.tags.map(tag => <span>{tag.replaceAll('_', ' ')}</span>)}</div><button class="text-link reader-toggle" id="reader-toggle" aria-pressed="false">Expand reading area</button></header>
      <div class="prose"><Content /></div>
      <div class="article-end"><a class="text-link" href={backUrl}>← Back to {backLabel}</a><a class="text-link" href={sourceUrl(entry)}>View source ↗</a></div>
    </article>
    <aside class="article-toc"><nav aria-label="On this page"><p class="eyebrow">On this page</p><ol>{sections.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav><a class="text-link" href="#main">Back to top ↑</a></aside>
  </div>
  <DiagramViewer />
  <script>
    const button = document.querySelector<HTMLButtonElement>('#reader-toggle');
    button?.addEventListener('click', () => {
      const enabled = document.body.classList.toggle('reader-mode');
      button.setAttribute('aria-pressed', String(enabled));
      button.textContent = enabled ? 'Standard reading area' : 'Expand reading area';
    });
  </script>
</Base>
