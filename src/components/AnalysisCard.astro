---
import type { CollectionEntry } from 'astro:content';
import { summary } from '../lib/analyses';
interface Props { entry: CollectionEntry<'analyses'>; number?: string; }
const { entry, number = '01' } = Astro.props;
---
<a class="analysis-card" href={`/analyses/${entry.id}/`}>
  <div class="card-top"><span class="mono muted">ANALYSIS / {number}</span><span class="status"><span aria-hidden="true"></span> Research notes</span></div>
  <div class="card-heading"><h3>{entry.data.title}</h3><span class="card-arrow" aria-hidden="true">↗</span></div>
  <p>{summary(entry)}</p>
  <div class="tags">{entry.data.tags.filter((tag) => tag !== 'malware').slice(0, 3).map((tag) => <span>{tag.replaceAll('_', ' ')}</span>)}</div>
</a>
