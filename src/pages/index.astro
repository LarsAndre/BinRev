---
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';
import { notebookSections } from '../lib/content';
const sections = await notebookSections();
const { data: home } = (await getEntry('home', 'index'))!;
---
<Base>
  <div class="container notebook-index">
    <header class="index-header"><h1>{home.title}</h1><p>{home.description}</p></header>
    {sections.map((section, index) => (
      <section class="index-section" aria-labelledby={`${section.id}-heading`}>
        <h2 id={`${section.id}-heading`}>{index + 1} - {section.data.title}</h2>
        {section.notes.length ? (
          <ul class="note-links">{section.notes.map(entry => <li><a href={entry.data.url}>{entry.data.title}<span aria-hidden="true">→</span></a></li>)}</ul>
        ) : <p class="empty-notes">No notes published yet.</p>}
      </section>
    ))}
  </div>
</Base>
