---
import NotePage from '../../components/NotePage.astro';
import { publishedAnalyses } from '../../lib/content';

export async function getStaticPaths() {
  return (await publishedAnalyses()).map(entry => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<NotePage entry={entry} />
