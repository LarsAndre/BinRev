---
import Base from '../../layouts/Base.astro';
import DiagramViewer from '../../components/DiagramViewer.astro';
import { render } from 'astro:content';
import { publishedResources, summary, sourceUrl } from '../../lib/content';
export async function getStaticPaths() { return (await publishedResources()).map(resource => ({ params: { slug: resource.id }, props: { resource } })); }
const { resource } = Astro.props;
const { Content } = await render(resource);
---
<Base title={resource.data.title} description={summary(resource)}><div class="container resource-page"><a class="breadcrumb" href="/resources/">← All resources</a><p class="eyebrow">{resource.data.sectionTitle} / {resource.data.format}</p><h1>{resource.data.title}<span class="brand-dot">.</span></h1><p class="page-description">{summary(resource)}</p><DiagramViewer image={resource.data.image} title={resource.data.title} /><div class="prose"><Content /></div><div class="article-end"><a class="text-link" href={resource.data.image} download>Download SVG ↓</a><a class="text-link" href={resource.data.original} download>Download original ↓</a><a class="text-link" href={sourceUrl(resource)}>View source ↗</a></div></div></Base>
