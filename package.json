{
  "name": "binrev-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-content": "node scripts/prepare-content.mjs",
    "dev": "npm run prepare-content && astro dev --host 127.0.0.1",
    "build": "npm run prepare-content && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "npm run prepare-content && astro check",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:browser:dev": "BINREV_TEST_DEV=1 playwright test",
    "export-diagrams": "node scripts/export-diagrams.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "astro": "7.3.5",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@excalidraw/excalidraw": "0.18.1",
    "@playwright/test": "^1.56.0",
    "esbuild": "^0.28.2",
    "lz-string": "^1.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "description": "Malware analysis and reverse-engineering notes"
}
